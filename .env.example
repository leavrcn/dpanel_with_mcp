# DPanel with MCP 环境变量示例（复制为 .env 后填写，.env 已被 gitignore）
# 生成 token：openssl rand -hex 32

# MCP Bearer token（必填）
DP_MCP_TOKEN=

# MCP 能力分级：read-only / read-write / admin（默认 read-write）
DP_MCP_PROFILE=read-write

# 面板账号（MCP 回环调用用）
# 也可不填：删掉 compose 里对应两行，首登设 founder 后走管理面 API 录入（见 README）
DP_MCP_SERVICE_USERNAME=

# 面板密码（同上）
DP_MCP_SERVICE_PASSWORD=
